{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "mcp__.*__(add_repo|allow_agent|archive_session|associate_pr|create_pr|deny_agent|git_fetch|link_reference|mark_pr_ready|pack_and_copy|push_branch|spawn_agent|start_session|stop_agent|update_session|upload_artifact)$",
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/hooks/record-session-mapping.mjs codex",
            "statusMessage": "Linking Polygraph agent session"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/hooks/reinject-polygraph-context.mjs",
            "statusMessage": "Re-injecting Polygraph session context"
          },
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/hooks/record-session-mapping.mjs codex",
            "statusMessage": "Linking Polygraph agent session"
          }
        ]
      }
    ]
  }
}
