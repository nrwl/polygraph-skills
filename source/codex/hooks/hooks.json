{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/hooks/reinject-polygraph-context.mjs",
            "statusMessage": "Re-injecting Polygraph session context"
          }
        ]
      }
    ]
  }
}
