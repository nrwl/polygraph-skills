{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node hooks/record-session-mapping.mjs cursor"
      }
    ],
    "postToolUse": [
      {
        "command": "node hooks/record-session-mapping.mjs cursor"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node hooks/ensure-agent-session-capture.mjs cursor --detach"
      }
    ]
  }
}
