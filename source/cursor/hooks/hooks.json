{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node hooks/record-session-mapping.mjs cursor"
      }
    ],
    "postToolUse": [
      {
        "command": "node hooks/record-session-mapping.mjs cursor"
      }
    ],
    "stop": [
      {
        "command": "node hooks/record-cursor-usage.mjs"
      }
    ]
  }
}
